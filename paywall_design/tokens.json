{
  "name": "Still",
  "version": "1.0.0",
  "rules": {
    "gradients": "forbidden — solid fills only, including icons, illustrations, buttons and backgrounds",
    "defaultScheme": "dark",
    "accent": "none — monochrome. Semantic colors are reserved for status only."
  },
  "color": {
    "dark": {
      "bg": "#000000",
      "surface": "#141414",
      "surfaceRaised": "#1E1E1E",
      "surfaceHigh": "#2A2A2A",
      "border": "#262626",
      "borderStrong": "#3A3A3A",
      "textPrimary": "#E8E8E8",
      "textSecondary": "#9C9C9C",
      "textTertiary": "#6E6E6E",
      "inverse": "#D6D6D6",
      "onInverse": "#0A0A0A",
      "scrim": "rgba(0,0,0,0.6)",
      "danger": "#E0605A",
      "success": "#5DB07E",
      "warning": "#D9A441"
    },
    "light": {
      "bg": "#FFFFFF",
      "surface": "#F3F3F3",
      "surfaceRaised": "#EAEAEA",
      "surfaceHigh": "#DEDEDE",
      "border": "#E4E4E4",
      "borderStrong": "#CDCDCD",
      "textPrimary": "#141414",
      "textSecondary": "#5E5E5E",
      "textTertiary": "#8A8A8A",
      "inverse": "#1A1A1A",
      "onInverse": "#F2F2F2",
      "scrim": "rgba(0,0,0,0.35)",
      "danger": "#C8433D",
      "success": "#2F8A57",
      "warning": "#A87414"
    }
  },
  "font": {
    "family": { "ios": "System (SF Pro)", "android": "System" },
    "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" }
  },
  "type": {
    "display":  { "size": 34, "lineHeight": 41, "weight": "700", "letterSpacing": 0.37 },
    "title1":   { "size": 28, "lineHeight": 34, "weight": "700", "letterSpacing": 0.36 },
    "title2":   { "size": 22, "lineHeight": 28, "weight": "700", "letterSpacing": 0.35 },
    "title3":   { "size": 20, "lineHeight": 25, "weight": "600", "letterSpacing": 0.38 },
    "prompt":   { "size": 24, "lineHeight": 30, "weight": "700", "letterSpacing": 0 },
    "headline": { "size": 17, "lineHeight": 22, "weight": "600", "letterSpacing": -0.41 },
    "body":     { "size": 17, "lineHeight": 22, "weight": "400", "letterSpacing": -0.41 },
    "callout":  { "size": 16, "lineHeight": 21, "weight": "400", "letterSpacing": -0.32 },
    "subhead":  { "size": 15, "lineHeight": 20, "weight": "400", "letterSpacing": -0.24 },
    "footnote": { "size": 13, "lineHeight": 18, "weight": "400", "letterSpacing": -0.08 },
    "caption":  { "size": 12, "lineHeight": 16, "weight": "400", "letterSpacing": 0 },
    "overline": { "size": 12, "lineHeight": 16, "weight": "600", "letterSpacing": 1.4, "textTransform": "uppercase" }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "14": 56 },
  "radius": { "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 28, "pill": 999 },
  "size": {
    "hitMin": 44,
    "buttonLg": 56,
    "buttonMd": 48,
    "buttonSm": 36,
    "iconButton": 44,
    "fab": 56,
    "icon": 24,
    "iconSm": 20,
    "tabBar": 49,
    "navBar": 44,
    "screenPadding": 20,
    "hairline": 0.5
  },
  "motion": {
    "fast": 150,
    "base": 250,
    "slow": 400,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "spring": { "damping": 20, "stiffness": 220, "mass": 1 },
    "pressScale": 0.97
  },
  "opacity": { "disabled": 0.4, "pressed": 0.7 }
}
